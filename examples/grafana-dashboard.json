{
  "uid": "crashcause",
  "title": "crashcause — Kubernetes crash causes",
  "description": "Overview of crashcause's classified Kubernetes crash diagnoses and pod-log rate-limiter health. Requires crashcause running in watch mode with --metrics-addr set (e.g. --metrics-addr :9090) and a Prometheus scrape job pointed at that /metrics endpoint. crashcause exposes exactly two metrics: crashcause_diagnoses_total{namespace,owner_kind,owner_name,cause} and crashcause_log_fetches_skipped_total (no labels).",
  "tags": ["crashcause", "kubernetes"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(crashcause_diagnoses_total, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(crashcause_diagnoses_total, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(crashcause_diagnoses_total, cause)",
        "hide": 0,
        "includeAll": true,
        "label": "Cause",
        "multi": true,
        "name": "cause",
        "options": [],
        "query": {
          "query": "label_values(crashcause_diagnoses_total, cause)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Crash diagnoses by cause",
      "description": "Rate of crashcause_diagnoses_total, split by cause. Filtered by the namespace and cause template variables.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "cps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cause) (rate(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=~\"$cause\"}[5m]))",
          "legendFormat": "{{cause}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Crash diagnoses by workload",
      "description": "Rate of crashcause_diagnoses_total, split by owner_kind/owner_name, summed across causes. Useful for spotting which specific workload is crashing the most.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "cps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, owner_kind, owner_name) (rate(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=~\"$cause\"}[5m]))",
          "legendFormat": "{{namespace}}/{{owner_kind}}/{{owner_name}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top crashing workloads (24h)",
      "description": "Top 10 workload/cause combinations by number of crash diagnoses over the last 24 hours.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, owner_kind, owner_name, cause) (increase(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=~\"$cause\"}[24h])))",
          "format": "table",
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {},
            "renameByName": {
              "namespace": "Namespace",
              "owner_kind": "Owner Kind",
              "owner_name": "Owner Name",
              "cause": "Cause",
              "Value": "Diagnoses (24h)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              { "field": "Diagnoses (24h)", "desc": true }
            ]
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "OOM kills",
      "description": "Total oom_killed diagnoses over the dashboard time window.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 25 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=\"oom_killed\"}[$__range]))",
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Liveness probe failures",
      "description": "Total probe_liveness_failure diagnoses over the dashboard time window.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 25 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=\"probe_liveness_failure\"}[$__range]))",
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Startup probe failures",
      "description": "Total probe_startup_failure diagnoses over the dashboard time window.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 25 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=\"probe_startup_failure\"}[$__range]))",
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Image pull failures",
      "description": "Total image_pull_* diagnoses (auth, not_found, other) over the dashboard time window.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 25 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(crashcause_diagnoses_total{namespace=~\"$namespace\", cause=~\"image_pull_.*\"}[$__range]))",
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Log fetches skipped (rate-limit saturation)",
      "description": "Rate of crashcause_log_fetches_skipped_total. This metric has no labels, so it cannot be filtered by namespace or cause. A sustained non-zero rate means the client-side pod-log token bucket (default 10 fetches/minute, tunable via --log-rate-limit) is saturated: crashcause is still producing diagnoses, but without pod-log evidence backing them, which can lower confidence in the classification. Investigate whether a crash storm is in progress or whether the rate limit needs raising.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "cps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(crashcause_log_fetches_skipped_total[5m])",
          "legendFormat": "log fetches skipped/sec",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    }
  ]
}
